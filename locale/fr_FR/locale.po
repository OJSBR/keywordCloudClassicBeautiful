msgid "plugins.block.keywordCloudClassicBeautiful.displayName"
msgstr "Nuage de mots-clés (classique) — OJSBR"

msgid "plugins.block.keywordCloudClassicBeautiful.description"
msgstr "Nuage, dans la barre latérale, des mots-clés des articles de la revue, dont la taille et la couleur varient selon la fréquence d’utilisation de chacun — le comportement classique, rendu entièrement côté serveur, sans bibliothèque JavaScript externe. Développé par OJSBR."

