msgid "plugins.block.keywordCloudClassicBeautiful.displayName"
msgstr "Nube de palabras clave (clásica) — OJSBR"

msgid "plugins.block.keywordCloudClassicBeautiful.description"
msgstr "Nube, en la barra lateral, de las palabras clave de los artículos de la revista, con tamaño y color según la frecuencia de uso de cada una — el comportamiento clásico, generado íntegramente en el servidor, sin biblioteca JavaScript externa. Desarrollado por OJSBR."

